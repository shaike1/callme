# ─────────────────────────────────────────────────────────────────
# OpenClaw 3CX Voice Stack — Environment Configuration
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.
# ─────────────────────────────────────────────────────────────────

# ── Network ───────────────────────────────────────────────────────
# Your server's LAN IP address.
# Must be reachable by the 3CX SBC (co-located on the same host).
# Use the LAN IP — NOT the public/WAN IP.
EXTERNAL_IP=YOUR_SERVER_LAN_IP

# ── drachtio ──────────────────────────────────────────────────────
DRACHTIO_HOST=127.0.0.1
DRACHTIO_PORT=9022
DRACHTIO_SECRET=change_me_to_a_random_secret
DRACHTIO_SIP_PORT=5070

# ── FreeSWITCH ────────────────────────────────────────────────────
FREESWITCH_HOST=127.0.0.1
FREESWITCH_PORT=8021
FREESWITCH_SECRET=JambonzR0ck$

# ── 3CX SIP ───────────────────────────────────────────────────────
# Your 3CX cloud hostname — found in 3CX Admin panel
SIP_DOMAIN=YOUR_COMPANY.3cx.cloud

# Where to send REGISTER requests.
# Use 127.0.0.1 when the SmartSBC runs on the same host (host service or Docker).
SIP_REGISTRAR=127.0.0.1

# ── OpenClaw AI bridge ────────────────────────────────────────────
# URL of the claude-api-server (Docker container or host process, both port 3333)
CLAUDE_API_URL=http://127.0.0.1:3333

# OpenClaw server coordinates — used by claude-api-server Docker container
# (only relevant when running with: docker compose --profile full up -d)
OPENCLAW_HOST=YOUR_OPENCLAW_SERVER_IP
OPENCLAW_PORT=18790

# ── App ports ─────────────────────────────────────────────────────
HTTP_PORT=3000
WS_PORT=3001
AUDIO_DIR=/app/audio

# ── MOSS TTS (GPU voice cloning) ─────────────────────────────────
# GPU-accelerated TTS via Gradio. When set, this is used FIRST before gTTS.
# Use 127.0.0.1:7860 when voice-app and MOSS TTS are on the same host.
# Use the host's LAN IP when voice-app is on a different machine (e.g. ARM VPS).
MOSS_TTS_URL=

# ── Optional: higher-quality TTS/STT fallbacks ───────────────────
# Leave blank to use free gTTS + Google Web Speech (recommended — no key needed)
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# ── Voice v2 / Gemini Live bridge ────────────────────────────────
# classic = existing Claude/TTS turn loop
# gemini-live = route conversation turns to the Python v2 processor / Gemini Live bridge
VOICE_CONVERSATION_ENGINE=classic
V2_PROCESS_URL=http://127.0.0.1:8080/api/v1/process
V2_LIVE_PULL_BASE=http://127.0.0.1:8080/api/v1/live/session
V2_HTTP_TIMEOUT_MS=45000
